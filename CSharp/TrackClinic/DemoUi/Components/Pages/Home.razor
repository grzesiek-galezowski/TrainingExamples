@page "/"
@rendermode InteractiveServer
@using DemoUi.Adapters.Configuration
@implements IDisposable
@inject HomePagePresenter Presenter
@inject AppConfig AppConfig

<PageTitle>TrackClinic Demo & Traffic Generator</PageTitle>

<div class="container">
    <div class="header">
        <div class="header-title">
            <h1>🎵 TrackClinic Demo & Traffic Generator</h1>
            <p>Target Service: <span class="code-badge">@AppConfig.TrackClinic.BaseUrl</span></p>
        </div>
        <div>
            @if (Presenter.Stats.IsContinuousRunning)
            {
                <span class="badge badge-green">● Streaming Traffic (@Presenter.Stats.ActiveConcurrency workers)</span>
            }
            else if (Presenter.IsBatchRunning || Presenter.IsSingleRunning)
            {
                <span class="badge badge-blue">● Running Scenario</span>
            }
            else
            {
                <span class="badge badge-purple">Idle</span>
            }
        </div>
    </div>

    <!-- Live Metrics Grid -->
    <div class="grid-stats">
        <div class="stat-card">
            <div class="stat-title">Total Requests</div>
            <div class="stat-value">@Presenter.Stats.TotalRequests</div>
            <div class="stat-sub">@Presenter.Stats.TotalScenarios total scenarios</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Current RPS</div>
            <div class="stat-value">@Presenter.Stats.CurrentRps.ToString("F0") <span style="font-size: 1rem; color: var(--text-muted);">req/s</span></div>
            <div class="stat-sub">Real-time throughput</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Success Rate</div>
            <div class="stat-value" style="color: @(Presenter.Stats.FailedRequests > 0 ? "#f87171" : "#34d399");">
                @Presenter.GetSuccessRate()%
            </div>
            <div class="stat-sub">@Presenter.Stats.SuccessfulRequests ok / @Presenter.Stats.FailedRequests failed</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Avg Latency</div>
            <div class="stat-value">@Presenter.Stats.AverageLatencyMs <span style="font-size: 1rem; color: var(--text-muted);">ms</span></div>
            <div class="stat-sub">Response time</div>
        </div>
    </div>

    <!-- Action Cards Grid -->
    <div class="grid-main">
        <!-- Single Scenario Card -->
        <div class="card">
            <div class="card-title">
                <span>1. Single Scenario</span>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;" @onclick="Presenter.PickRandomPreset" disabled="@(Presenter.IsSingleRunning || Presenter.Stats.IsContinuousRunning)">
                    🎲 New Seed
                </button>
            </div>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">
                Executes: <strong>POST</strong> song 1 &rarr; <strong>POST</strong> song 2 &rarr; <strong>GET</strong> song 1 &rarr; <strong>GET</strong> song 2
            </p>

            <div class="form-group">
                <label class="form-label">Artist Name</label>
                <input class="form-input" @bind="Presenter.Preset.Artist" disabled="@(Presenter.IsSingleRunning || Presenter.Stats.IsContinuousRunning)" />
            </div>

            <div class="form-group">
                <label class="form-label">Song 1 Title</label>
                <input class="form-input" @bind="Presenter.Preset.Song1" disabled="@(Presenter.IsSingleRunning || Presenter.Stats.IsContinuousRunning)" />
            </div>

            <div class="form-group">
                <label class="form-label">Song 2 Title</label>
                <input class="form-input" @bind="Presenter.Preset.Song2" disabled="@(Presenter.IsSingleRunning || Presenter.Stats.IsContinuousRunning)" />
            </div>

            <div class="btn-row">
                <button class="btn btn-primary" style="flex: 1;" @onclick="Presenter.RunSingle" disabled="@(Presenter.IsSingleRunning || Presenter.IsBatchRunning || Presenter.Stats.IsContinuousRunning)">
                    @if (Presenter.IsSingleRunning)
                    {
                        <span>⏳ Running Scenario...</span>
                    }
                    else
                    {
                        <span>▶ Run Single Scenario</span>
                    }
                </button>
            </div>

            @if (Presenter.LastSingleResult != null)
            {
                <div class="scenario-result-box">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <span style="font-weight: 600; font-size: 0.9rem;">
                            Result:
                            @if (Presenter.LastSingleResult.Success)
                            {
                                <span style="color: #34d399;">✔ Succeeded</span>
                            }
                            else
                            {
                                <span style="color: #f87171;">✖ Failed</span>
                            }
                        </span>
                        <span style="font-size: 0.8rem; color: var(--text-muted);">
                            Duration: @(Presenter.LastSingleResult.TotalElapsedMilliseconds)ms
                        </span>
                    </div>

                    @foreach (var step in Presenter.LastSingleResult.Steps)
                    {
                        <div class="step-item">
                            <div>
                                <span class="badge @(step.HttpMethod == "POST" ? "badge-blue" : "badge-purple")" style="font-size: 0.7rem; padding: 0.15rem 0.4rem;">
                                    @step.HttpMethod
                                </span>
                                <span style="margin-left: 0.4rem;">@step.ActionName</span>
                            </div>
                            <div>
                                <span class="badge @(step.IsSuccess ? "badge-green" : "badge-red")" style="font-size: 0.7rem; padding: 0.15rem 0.4rem;">
                                    @(step.StatusCode.HasValue ? step.StatusCode.Value.ToString() : "ERR")
                                </span>
                                <span style="margin-left: 0.4rem; color: var(--text-muted); font-size: 0.75rem;">
                                    @(step.ElapsedMilliseconds)ms
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Concurrent Traffic Generator Card -->
        <div class="card">
            <div class="card-title">
                <span>2. Concurrent Traffic Generator</span>
                <span class="badge badge-amber">For Grafana & Monitoring</span>
            </div>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">
                Simulates multiple concurrent users creating and fetching songs continuously to observe Grafana dashboards and Prometheus metrics.
            </p>

            <div class="form-group">
                <label class="form-label">Concurrent Workers: <strong>@Presenter.Concurrency</strong></label>
                <input type="range" class="form-input" min="1" max="25" step="1" @bind="Presenter.Concurrency" @bind:event="oninput" disabled="@Presenter.Stats.IsContinuousRunning" />
            </div>

            <div class="form-group">
                <label class="form-label">Delay Between Scenarios: <strong>@(Presenter.DelayMs)ms</strong></label>
                <input type="range" class="form-input" min="0" max="1000" step="50" @bind="Presenter.DelayMs" @bind:event="oninput" disabled="@Presenter.Stats.IsContinuousRunning" />
            </div>

            <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; margin-top: 1.5rem;">
                <label class="form-label">Mode A: Batch Traffic Run</label>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <select class="form-select" style="max-width: 160px;" @bind="Presenter.BatchCount" disabled="@(Presenter.IsBatchRunning || Presenter.Stats.IsContinuousRunning)">
                        <option value="10">10 Scenarios</option>
                        <option value="25">25 Scenarios</option>
                        <option value="50">50 Scenarios</option>
                        <option value="100">100 Scenarios</option>
                    </select>
                    <button class="btn btn-primary" style="flex: 1;" @onclick="Presenter.RunBatch" disabled="@(Presenter.IsBatchRunning || Presenter.IsSingleRunning || Presenter.Stats.IsContinuousRunning)">
                        @if (Presenter.IsBatchRunning)
                        {
                            <span>⏳ Running Batch...</span>
                        }
                        else
                        {
                            <span>⚡ Run Batch</span>
                        }
                    </button>
                </div>
            </div>

            <div style="border-top: 1px solid var(--border-color); padding-top: 1rem; margin-top: 1.5rem;">
                <label class="form-label">Mode B: Continuous Traffic Stream</label>
                <div class="btn-row" style="margin-top: 0.5rem;">
                    @if (!Presenter.Stats.IsContinuousRunning)
                    {
                        <button class="btn btn-success" style="flex: 1;" @onclick="Presenter.StartContinuous" disabled="@(Presenter.IsBatchRunning || Presenter.IsSingleRunning)">
                            🚀 Start Continuous Traffic
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-danger" style="flex: 1;" @onclick="Presenter.StopContinuous">
                            ⏹ Stop Traffic Stream
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Live Activity Log Table -->
    <div class="table-container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div style="font-size: 1.15rem; font-weight: 600;">
                Live Request Activity Log <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 400;">(Last @Presenter.RecentLogs.Count requests)</span>
            </div>
            <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;" @onclick="Presenter.ResetStats" disabled="@(Presenter.Stats.IsContinuousRunning || Presenter.IsBatchRunning)">
                🔄 Reset Stats & Logs
            </button>
        </div>

        @if (Presenter.RecentLogs.Count == 0)
        {
            <div style="text-align: center; color: var(--text-muted); padding: 2rem;">
                No requests recorded yet. Click <strong>"Run Single Scenario"</strong>, <strong>"Run Batch"</strong>, or <strong>"Start Continuous Traffic"</strong> to generate traffic.
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width: 100px;">Time</th>
                        <th style="width: 80px;">Scenario</th>
                        <th style="width: 80px;">Method</th>
                        <th>Endpoint / Action</th>
                        <th style="width: 90px;">Status</th>
                        <th style="width: 90px; text-align: right;">Latency</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Presenter.RecentLogs.Reverse().Take(30))
                    {
                        <tr>
                            <td style="color: var(--text-muted); font-size: 0.8rem;">
                                @log.Timestamp.ToString("HH:mm:ss.fff")
                            </td>
                            <td>
                                <span class="code-badge">@log.ScenarioId</span>
                            </td>
                            <td>
                                <span class="badge @(log.HttpMethod == "POST" ? "badge-blue" : "badge-purple")">
                                    @log.HttpMethod
                                </span>
                            </td>
                            <td>
                                <div style="font-weight: 500;">@log.Details</div>
                                <div style="font-size: 0.75rem; color: var(--text-muted); font-family: monospace;">@log.Endpoint</div>
                            </td>
                            <td>
                                <span class="badge @(log.Success ? "badge-green" : "badge-red")">
                                    @(log.StatusCode.HasValue ? log.StatusCode.Value.ToString() : "ERR")
                                </span>
                            </td>
                            <td style="text-align: right; font-family: monospace;">
                                @(log.ElapsedMilliseconds)ms
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
  protected override void OnInitialized()
  {
    Presenter.OnStateChanged += HandleStateChanged;
    Presenter.Initialize();
  }

  private void HandleStateChanged()
  {
    InvokeAsync(StateHasChanged);
  }

  public void Dispose()
  {
    Presenter.OnStateChanged -= HandleStateChanged;
    Presenter.Dispose();
  }
}